NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# To set up Supabase:
# 1. Go to https://supabase.com
# 2. Create new project
# 3. Copy URL and anon key from Settings > API
# 4. Paste above
# 5. Run SQL schema (see supabase-schema.sql)

